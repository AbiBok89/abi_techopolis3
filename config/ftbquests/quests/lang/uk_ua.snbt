	quest.65B5A6E53B347435.quest_desc: ["Виготовляється всередині &lМіжвимірного інфузора&r"]
	quest.65BA2A6A35C05B9D.quest_desc: ["Поєднання &l&#8B4513Стародавні уламки&r та &l&eзолота&r"]
