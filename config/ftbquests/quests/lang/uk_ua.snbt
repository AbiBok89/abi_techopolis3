	quest.153B62DEC5635C8D.title: "Основа для великоднього яйця"
	quest.15499AC0CD9B7843.quest_desc: ["Дає можливість створювати моделі даних таких босів, як Візери та Дракони"]
	quest.15499AC0CD9B7843.title: "Модель даних боса"
	quest.156D74B785F34B66.quest_desc: ["Просте транспортування рідин"]
	quest.15829566832C5AB7.quest_desc: ["Переплавлені &lГлиняні кульки&r"]
	quest.15E6A11E3325137D.quest_desc: ["Перетворює &lядерні відходи&r на &lплутоній&r. Зламана з радіоактивними матеріалами всередині випромінює радіацію."]
	quest.15F835CD334040B1.quest_desc: ["Гарний блок"]
	quest.161B4D2963F205F1.quest_desc: ["Розміщення більшої кількості цих пристроїв у радіусі дії Око-крафтера збільшить його швидкість"]
	quest.161B4D2963F205F1.title: "Флакс-альтернатор"
	quest.164B6FAB9100BA01.quest_desc: ["Доступно у варіантах на 2 та 3 слоти"]
	quest.164B6FAB9100BA01.title: "Ущільнення"
	quest.166A2386E894F6B2.quest_desc: ["Виготовляється в &lШтампувальний пресі&r"]
	quest.169753582E9B8F26.quest_desc: ["На &lзовнішніх островах Енду&r ростуть великі рослини; якщо їх зламати, можна отримати &lплоди хорусу&r."]
	quest.169DB21BB2060530.quest_desc: [
		"Селектор планет Stellaris зламаний, тому вам потрібно створити портал на Місяць із &l&#555555Block of Netherite&r та активувати його за допомогою &l&9Rocket&r."
		""
		"Портал будується у &l&bНадсвіті&r і виглядає як звичайний &l&4Портал у Незер&r."
	]
	quest.169DB21BB2060530.title: "Місячний портал"
	quest.16BC5C3507E58E72.quest_desc: ["Кращий сплав"]
	quest.16D36D610F7D7A61.quest_desc: ["Високорівневий ресурс"]
	quest.16DB448912997A88.quest_desc: ["Редстоун та мідь утворюють наповнений сплав"]
	quest.16F70B092D615AC1.quest_desc: ["Створюється в &lNether Mob Infuser&r, потребує багато енергії!"]
	quest.16F70B092D615AC1.quest_subtitle: "&l&0Частина пекельного техніуму&r&r"
	quest.1705CFCE2C0CA200.quest_desc: ["Використовує &lАльтернатори&r для виготовлення"]
	quest.1705CFCE2C0CA200.title: "Ендер-крафтер"
	quest.170D6090A1967B58.quest_desc: ["Більшість предметів у світі складаються з різної матерії. Ці резервуари дозволяють її зберігати"]
	quest.170D6090A1967B58.title: " Бак для матерії"
	quest.1736CCBC0F8B3CB8.quest_desc: ["Гарний стрижень"]
	quest.1736CCBC0F8B3CB8.quest_subtitle: "&e&lЧастина Енд-Техніуму&r&r"
