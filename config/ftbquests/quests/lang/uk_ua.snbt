	quest.1743EA1ABE7F6661.title: "Дерев'яні ножиці"
	quest.17455D6476E03296.quest_desc: ["Дозволяє сортувати рідини. Дивіться посібник для отримання детальнішої інформації про використання."]
	quest.1757F2A54B7E06B9.quest_desc: ["Можна знайти в &lНезері&r; &lЦифровий шахтар&r допоможе зібрати це швидше"]
	quest.178E2312A0BFE050.quest_desc: [
