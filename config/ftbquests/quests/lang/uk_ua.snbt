	quest.5746F2D13AA6DC19.quest_desc: ["Збагачує &lКамінь&r, перетворюючи його на різні типи &lКаменів&r. Для роботи потребує &lФокусуючий кристал&r."]
	quest.5746F2D13AA6DC19.title: "Збагачувач породи"
	quest.5752D9267316F462.quest_desc: ["Ці комірки споживають дуже багато енергії!"]
