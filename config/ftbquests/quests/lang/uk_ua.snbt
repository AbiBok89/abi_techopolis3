	quest.149BF1FC5BDBED7C.quest_desc: ["Дозволяє виготовляти &lВугілля&r безпосередньо у &lЗатверджувачі&r"]
	quest.149BF1FC5BDBED7C.title: "Форма для самоцвітів"
