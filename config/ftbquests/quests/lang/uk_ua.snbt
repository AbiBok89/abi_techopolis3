	quest.608F27DF02EE7DCF.quest_desc: ["&lInterdimensional Infuser&r може насичувати наші предмети енергією з інших &lпланет&r."]
	quest.608F27DF02EE7DCF.title: "Міжвимірний інфузер"
	quest.60B9BB29ECBF2C64.quest_desc: ["Бочка для зберігання &lядерних відходів&r. З часом розпадається."]
	quest.60BE0700CA919BF6.quest_desc: ["Дозволяє добувати блоки типу &lЗемлі&r в області 3x3"]
